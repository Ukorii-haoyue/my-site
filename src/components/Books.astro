---
import "../styles/books.css";
---

<section class="books-section" id="books">

  <!-- 左侧扉页 -->
  <div class="books-intro">
    <div class="books-intro-top"></div>
    <h2>
      Books<br />
      I've<br />
      Read
    </h2>
    <a href={`${import.meta.env.BASE_URL}book-records/`} class="book-all-link">all →</a>
  </div>

  <!-- 书页区域（客户端填充） -->
  <div class="books-pages" id="books-pages">
    <div style="padding:2rem;color:#999;">Loading books...</div>
  </div>

</section>

<script src="../scripts/books.js"></script>

<script>
  import { supabase } from "../lib/supabase.js";

  const palette = [
    "#F9D4DC", "#D4EDDF", "#F7EDC4", "#F9D4BC",
    "#D6E2F5", "#E3D1F0", "#F6D3E3", "#E8D4BC",
  ];

  async function loadBooks() {
    const container = document.getElementById("books-pages");
    if (!container) return;

    try {
      const { data: books, error } = await supabase
        .from("books")
        .select("id, title, author, description, image_url")
        .order("id", { ascending: true });

      if (error) throw error;

      if (!books || books.length === 0) {
        container.innerHTML = '<div style="padding:2rem;color:#999;">No books yet ♡</div>';
        return;
      }

      container.innerHTML = books.map((book, index) => {
        const num = String(index + 1).padStart(2, "0");
        const color = palette[index % palette.length];
        const base = import.meta.env.BASE_URL;
        const cover = book.image_url
          ? `<img src="${book.image_url}" alt="${book.title}" />`
          : `<div class="cover-empty"><span>${book.title}</span></div>`;
        return `
          <article class="book-page ${index === 0 ? "is-active" : ""}" data-book="${index}" style="--book-color:${color};">
            <div class="book-collapsed">
              <span class="book-number">${num}</span>
              <span class="book-title-vertical">${book.title}</span>
            </div>
            <div class="book-expanded">
              <div class="book-content">
                <div class="book-info">
                  <h3>${book.title}</h3>
                  <p class="book-author">${book.author || ""}</p>
                  <a class="book-note-link" href="${base}/book-records/${book.id}/">read my note <span>↗</span></a>
                </div>
                <div class="book-cover">
                  <div class="cover-frame">${cover}</div>
                </div>
              </div>
            </div>
          </article>`;
      }).join("");

      // 重新绑定手风琴交互
      if (window.initBooksAccordion) window.initBooksAccordion();
    } catch (e) {
      container.innerHTML = '<div style="padding:2rem;color:#999;">Failed to load books.</div>';
    }
  }

  document.addEventListener("astro:page-load", loadBooks);
  if (document.readyState !== "loading") loadBooks();
</script>
