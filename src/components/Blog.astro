---
import "../styles/blog.css";
---

<section class="blog-section" id="blog">

  <!-- 顶部标题 -->
  <div class="blog-header">
    <div class="blog-header-left">MY BLOG</div>
    <div class="blog-header-center">Blog</div>
  </div>

  <!-- 最新文章列表（客户端填充） -->
  <div class="blog-list" id="blog-list">
    <div class="blog-empty">Loading posts...</div>
  </div>

  <!-- 查看全部 -->
  <a class="blog-all-link" href={`${import.meta.env.BASE_URL}blog/`}>
    all →
  </a>

</section>

<script>
  import { supabase } from "../lib/supabase.js";

  async function loadBlogs() {
    const list = document.getElementById("blog-list");
    if (!list) return;

    try {
      const { data: posts, error } = await supabase
        .from("blogs")
        .select("id, title, created_at")
        .eq("is_visible", true)
        .order("created_at", { ascending: false })
        .limit(4);

      if (error) throw error;

      if (!posts || posts.length === 0) {
        list.innerHTML = '<div class="blog-empty">No posts yet ♡</div>';
        return;
      }

      list.innerHTML = posts.map((post, index) => {
        const d = new Intl.DateTimeFormat("en-CA", {
          timeZone: "Asia/Shanghai", year: "numeric", month: "2-digit", day: "2-digit",
        }).formatToParts(new Date(post.created_at));
        const get = (t) => d.find((p) => p.type === t)?.value ?? "";
        const date = `${get("year")}.${get("month")}.${get("day")}`;
        const num = String(index + 1).padStart(2, "0");
        const base = import.meta.env.BASE_URL;
        return `
          <a class="blog-row" href="${base}/blog/${post.id}/">
            <span class="blog-number">${num}</span>
            <div class="blog-row-info">
              <h3>${post.title}</h3>
              <span class="blog-date">${date}</span>
            </div>
            <span class="blog-arrow">↗</span>
          </a>`;
      }).join("");
    } catch (e) {
      list.innerHTML = '<div class="blog-empty">Failed to load posts.</div>';
    }
  }

  document.addEventListener("astro:page-load", loadBlogs);
  if (document.readyState !== "loading") loadBlogs();
</script>
