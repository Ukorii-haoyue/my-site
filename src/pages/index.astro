---
import Layout from "../layouts/Layout.astro";

import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Timeline from "../components/Timeline.astro";
import Blog from "../components/Blog.astro";
import Footer from "../components/Footer.astro";
import Films from "../components/Films-carousel.astro";
import BakeDiary from "../components/BakeDiary.astro";
import Books from "../components/Books.astro";
import Friends from "../components/Friends.astro";

---
<script>
	// 平滑滚动（Lenis）：直接在此初始化，确保被 Astro 正确打包
	// （原来的 import 单独一行写法不会被打包，浏览器请求 /scripts/lenis.js 会 404）
	import Lenis from "lenis";

	const lenis = new Lenis({
		duration: 1.2,
		smoothWheel: true,
		smoothTouch: false,
	});

	function raf(time) {
		lenis.raf(time);
		requestAnimationFrame(raf);
	}

	requestAnimationFrame(raf);
</script>


<Layout title="UKORII">

	<Navbar />

	<Hero />

	<Timeline />

	<Blog />

	<Films />

	<Books />

	<BakeDiary />

	<Friends />

	<Footer />

</Layout>