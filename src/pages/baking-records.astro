---
// src/pages/baking-records.astro
// 烘焙记录：改为浏览器端实时从 Supabase 读取，
// 后台新增/更新后无需重新部署即可在列表看到。
import "../styles/baking-records.css";
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>

  <link rel="icon" type="image/png" href="/images/cursor3.png" />

  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>My Baking Records</title>
</head>


<body>

  <main class="baking-records">


    <!-- 返回首页 -->
    <a
      href={`${import.meta.env.BASE_URL}`}
      class="back-link"
    >
      ← back
    </a>


    <!-- 页面标题 -->
    <header class="records-header">

      <p class="small-title">
        MY BAKING DIARY
      </p>

      <h1>
        My Baking<br />
        <span>Records</span>
      </h1>

      <p class="intro">
        <span class="intro-cn">厨房小白黑暗料理中……</span><br />
       little cakes, warm bread, and sweet things from my kitchen.
      </p>

    </header>


    <!-- 烘焙记录（浏览器端填充） -->
    <section class="baking-grid" id="baking-grid">
      <div class="empty-baking">Loading recipes...♡</div>
    </section>


    <!-- Footer -->
    <footer class="records-footer">
      <span>Uko's Diary</span>
      <span>♡</span>
      <span>baked with love</span>
    </footer>


  </main>


  <script>
    import { supabase } from "../lib/supabase.js";

    // 后台日期为 YYYY-MM-DD，展示为 YYYY.MM.DD
    const formatDate = (value) =>
      value ? String(value).slice(0, 10).replaceAll("-", ".") : "";

    /* =========================
       渲染烘焙卡片
    ========================= */
    async function loadBaking() {
      const grid = document.getElementById("baking-grid");

      const { data, error } = await supabase
        .from("baking")
        .select("id, title, date, description, image_url, created_at")
        .order("created_at", { ascending: false });

      if (error) {
        console.error("读取烘焙记录失败：", error);
        grid.innerHTML = '<div class="empty-baking">Failed to load.</div>';
        return;
      }

      if (!data || data.length === 0) {
        grid.innerHTML = '<div class="empty-baking">Nothing baked yet ♡</div>';
        return;
      }

      grid.innerHTML = data.map((item, index) => `
        <article class="baking-card">
          <div class="baking-image">
            ${item.image_url
              ? `<img src="${item.image_url}" alt="${item.title ?? ""}" loading="lazy" />`
              : `<div class="img-empty">No photo ♡</div>`}
            <span class="baking-number">${String(index + 1).padStart(2, "0")}</span>
          </div>
          <div class="baking-info">
            <div class="baking-meta">
              <span>${formatDate(item.date)}</span>
            </div>
            <h2>${item.title ?? ""}</h2>
            <p>${item.description ?? ""}</p>
            <div class="baking-like">
              <div class="baking-heart" data-id="${item.id}" role="button" aria-label="like">♡</div>
              <span class="baking-like-count" data-count-for="${item.id}">0</span>
            </div>
          </div>
        </article>
      `).join("");

      initLikes();
    }

    /* =========================
       爱心点赞：Supabase 全局计数，所有访客共享
    ========================= */
    const VISITOR_KEY = "uko-visitor-id";

    function getVisitorId() {
      let id = localStorage.getItem(VISITOR_KEY);
      if (!id) {
        id = crypto.randomUUID();
        localStorage.setItem(VISITOR_KEY, id);
      }
      return id;
    }

    function initLikes() {
      const visitorId = getVisitorId();

      const hearts = Array.from(
        document.querySelectorAll(".baking-heart")
      );

      const countEls = {};
      document
        .querySelectorAll(".baking-like-count")
        .forEach((el) => {
          countEls[el.dataset.countFor] = el;
        });

      let likeRows = [];

      const sameId = (row, id) =>
        String(row.baking_id) === String(id);

      const likedByMe = (id) =>
        likeRows.some(
          (row) => sameId(row, id) && row.visitor_id === visitorId
        );

      const countFor = (id) =>
        likeRows.filter((row) => sameId(row, id)).length;

      function renderHeart(heart) {
        const id = heart.dataset.id;
        const liked = likedByMe(id);

        heart.classList.toggle("is-liked", liked);
        heart.textContent = liked ? "♥" : "♡";

        const countEl = countEls[id];
        if (countEl) {
          countEl.textContent = String(countFor(id));
          countEl.classList.toggle("is-liked", liked);
        }
      }

      async function loadLikes() {
        const { data, error } = await supabase
          .from("baking_likes")
          .select("baking_id, visitor_id");

        if (error) {
          console.error("读取点赞失败：", error);
          return;
        }

        likeRows = data || [];
        hearts.forEach(renderHeart);
      }

      hearts.forEach((heart) => {
        heart.addEventListener("click", async (event) => {
          event.stopPropagation();

          const id = Number(heart.dataset.id);
          const wasLiked = likedByMe(id);

          if (wasLiked) {
            likeRows = likeRows.filter(
              (row) => !(sameId(row, id) && row.visitor_id === visitorId)
            );
          } else {
            likeRows.push({ baking_id: id, visitor_id: visitorId });

            heart.classList.remove("heart-pop");
            void heart.offsetWidth;
            heart.classList.add("heart-pop");
          }

          hearts.forEach(renderHeart);

          if (wasLiked) {
            const { error } = await supabase
              .from("baking_likes")
              .delete()
              .eq("baking_id", id)
              .eq("visitor_id", visitorId);

            if (error) {
              console.error("取消点赞失败：", error);
              await loadLikes();
              alert("取消点赞失败，请稍后再试 ♡");
            }
          } else {
            const { error } = await supabase
              .from("baking_likes")
              .insert(
                { baking_id: id, visitor_id: visitorId },
                { onConflict: "baking_id,visitor_id", ignoreDuplicates: true }
              );

            if (error) {
              console.error("点赞失败：", error);
              await loadLikes();
              alert("点赞失败，请稍后再试 ♡");
            }
          }
        });
      });

      loadLikes();
    }

    loadBaking();
  </script>

</body>
</html>
