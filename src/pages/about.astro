<!-- =========================
     三栏主体：日历 | 自我介绍 | 公告
========================== -->

<div class="about-grid">


  <!-- ========== 左栏：calendar（实时日期） ========== -->

  <aside class="col col-left">

    <div class="card calendar-card">

      <h2 class="card-title">
        calendar
      </h2>

      <p class="calendar-month">
        {monthLabel}
