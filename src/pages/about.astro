    </div>

  </main>



  <!-- ========== 右栏：announcements（最新公告） ========== -->

  <aside class="col col-right">

    <div class="card announcements-card">

      <h2 class="card-title">
        announcements
      </h2>

      <ul class="notice-list">

        {noticePosts.length > 0 ? (
          noticePosts.map((post) => (
            <li>
              <span class="notice-date">
                {formatNoticeDate(post.created_at)}
              </span>
              <p>
                <a
                  class="notice-link"
                  href={`/blog/${post.id}/`}
                >
