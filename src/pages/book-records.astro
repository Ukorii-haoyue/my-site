---
// src/pages/book-records.astro
// 书单列表：改为浏览器端实时从 Supabase 读取，
// 后台新增/更新书籍后无需重新部署即可在列表看到。
import "../styles/book-records.css";
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>

  <link rel="icon" type="image/png" href="/images/cursor3.png" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>My Book Records</title>
</head>

<body>

  <main class="book-records">

    <!-- 返回首页 -->
    <a href={`${import.meta.env.BASE_URL}`} class="back-link">
      ← back
    </a>


    <!-- 页面标题 -->
    <header class="records-header">

      <p class="small-title">
        MY BOOK DIARY
      </p>

      <h1>
        My Book<br />
        <span>Records</span>
      </h1>

      <p class="intro">
        <span class="intro-cn">收录了一些在大学期间胡乱看的书籍嘻嘻</span><br />
        books I read, remembered, and quietly kept in my diary.
      </p>

    </header>


    <!-- 书籍列表（浏览器端填充） -->
    <section class="book-list" id="book-list">
      <div class="empty-books">Loading books...♡</div>
    </section>


    <!-- 翻页工具 -->
    <nav class="records-pager" id="book-pager" aria-label="翻页" style="display: none;">
      <button type="button" class="pager-btn" data-pager="prev">← prev</button>
      <span class="pager-info">NO.1 / 1</span>
      <button type="button" class="pager-btn" data-pager="next">next →</button>
    </nav>


    <!-- 底部 -->
    <footer class="records-footer">
      <span>Uko's Diary</span>
      <span>♡</span>
      <span>My little library</span>
    </footer>

  </main>

  <script>
    import { supabase } from "../lib/supabase.js";

    const base = import.meta.env.BASE_URL;
    const PER_PAGE = 6;

    function setupPagination() {
      const list = document.getElementById("book-list");
      const pager = document.getElementById("book-pager");
      if (!list || !pager) return;

      const items = list.querySelectorAll(".book-record");
      const totalPages = Math.max(1, Math.ceil(items.length / PER_PAGE));
      let current = 1;

      const prevBtn = pager.querySelector('[data-pager="prev"]');
      const nextBtn = pager.querySelector('[data-pager="next"]');
      const info = pager.querySelector(".pager-info");

      function render() {
        items.forEach((item, i) => {
          const page = Math.floor(i / PER_PAGE) + 1;
          item.style.display = page === current ? "" : "none";
        });
        info.textContent = `NO.${current} / ${totalPages}`;
        prevBtn.disabled = current <= 1;
        nextBtn.disabled = current >= totalPages;
      }

      if (items.length <= PER_PAGE) {
        pager.style.display = "none";
        return;
      }
      pager.style.display = "";
      prevBtn.onclick = () => {
        if (current <= 1) return;
        current -= 1;
        render();
      };
      nextBtn.onclick = () => {
        if (current >= totalPages) return;
        current += 1;
        render();
      };
      render();
    }

    async function loadBooks() {
      const list = document.getElementById("book-list");

      const { data, error } = await supabase
        .from("books")
        .select("id, title, author")
        .order("id", { ascending: true });

      if (error) {
        console.error("读取书籍失败：", error);
        list.innerHTML = '<div class="empty-books">Failed to load books.</div>';
        return;
      }

      if (!data || data.length === 0) {
        list.innerHTML = '<div class="empty-books">No books yet ♡</div>';
        return;
      }

      list.innerHTML = data.map((book, index) => `
        <a class="book-record" href="${base}book-records/${book.id}/">
          <div class="book-number">${String(index + 1).padStart(2, "0")}</div>
          <div class="book-info">
            <h2>${book.title ?? ""}</h2>
            <div class="book-meta">
              <span>${book.author ?? ""}</span>
            </div>
          </div>
          <div class="book-mark">♡</div>
        </a>
      `).join("");

      setupPagination();
    }

    loadBooks();
  </script>

</body>
</html>
