---
import "../../styles/admin.css";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Baking · Admin · Uko's Diary</title>
</head>

<body>

<div class="admin-page">

  <header class="admin-header">
    <div>
      <h1>Baking</h1>
      <p>Manage your baking diary ♡</p>
    </div>

    <div>
      <a href={`${import.meta.env.BASE_URL}/admin`}>Dashboard</a>
      <button id="logoutBtn">Logout</button>
    </div>
  </header>


  <!-- Add Baking -->
  <section class="admin-card">

    <h2 id="formTitle">+ Add Baking</h2>

    <form id="bakingForm" class="admin-form">

      <label>
        Title
        <input
          id="titleInput"
          type="text"
          placeholder="e.g. Strawberry Cake"
          required
        />
      </label>

      <label>
        Date
        <input
          id="dateInput"
          type="date"
          required
        />
      </label>

      <label>
        Description
        <textarea
          id="descriptionInput"
          placeholder="Write something about this baking..."
        ></textarea>
      </label>

      <label>
        Baking Image
        <input
          id="imageInput"
          type="file"
          accept="image/*"
          required
        />
        <small id="imageHint" class="upload-hint"></small>
      </label>

      <div class="admin-form-actions" style="justify-content:flex-start;">

        <button
          id="cancelEditBtn"
          type="button"
          class="cancel-edit-btn"
          style="display:none;"
        >
          Cancel Edit
        </button>

        <button id="saveBtn" type="submit">
          Save Baking
        </button>

      </div>

    </form>

  </section>


  <!-- Baking List -->
  <section>

    <div id="loading" class="loading">
      Loading baking diary...
    </div>

    <div
      id="bakingGrid"
      class="admin-grid"
      style="display:none;"
    ></div>

  </section>

</div>


<script>
  import { supabase } from "../../lib/supabase.js";

  const form = document.getElementById("bakingForm");
  const titleInput = document.getElementById("titleInput");
  const dateInput = document.getElementById("dateInput");
  const descriptionInput = document.getElementById("descriptionInput");
  const imageInput = document.getElementById("imageInput");
  const bakingGrid = document.getElementById("bakingGrid");
  const loading = document.getElementById("loading");
  const saveBtn = document.getElementById("saveBtn");
  const logoutBtn = document.getElementById("logoutBtn");
  const formTitle = document.getElementById("formTitle");
  const imageHint = document.getElementById("imageHint");
  const cancelEditBtn = document.getElementById("cancelEditBtn");

  let editingId = null;
  let editingImageUrl = "";


  // =========================
  // Check Admin
  // =========================

  async function checkAdmin() {

    const {
      data: { user },
      error
    } = await supabase.auth.getUser();

    if (error || !user) {
      window.location.href = "/admin";
      return false;
    }

    const { data: profile, error: profileError } = await supabase
      .from("profiles")
      .select("is_admin")
      .eq("id", user.id)
      .single();

    if (
      profileError ||
      !profile ||
      !profile.is_admin
    ) {
      alert("You do not have permission to access this page.");
      window.location.href = "/admin";
      return false;
    }

    return true;
  }


  // =========================
  // Load Baking
  // =========================

  async function loadBaking() {

    loading.style.display = "block";
    bakingGrid.style.display = "none";

    const {
      data,
      error
    } = await supabase
      .from("baking")
      .select(
        "id, title, date, description, image_url, created_at"
      )
      .order("created_at", {
        ascending: false
      });

    if (error) {

      console.error(error);

      loading.textContent =
        "Failed to load baking diary.";

      return;
    }

    loading.style.display = "none";
    bakingGrid.style.display = "grid";

    bakingGrid.innerHTML = "";

    if (!data || data.length === 0) {

      bakingGrid.innerHTML = `
        <p style="
          color:#b28b94;
          grid-column:1/-1;
          text-align:center;
        ">
          No baking records yet ♡
        </p>
      `;

      return;
    }


    data.forEach((item) => {

      const card = document.createElement("article");

      card.className = "admin-item";

      card.innerHTML = `

        ${
          item.image_url
            ? `
              <img
                src="${item.image_url}"
                alt="${escapeHtml(item.title)}"
              />
            `
            : ""
        }

        <div class="admin-item-content">

          <h3>
            ${escapeHtml(item.title)}
          </h3>

          <p class="baking-date">
            ${item.date || ""}
          </p>

          <p>
            ${escapeHtml(item.description || "")}
          </p>

          <button
            class="edit-btn"
            data-id="${item.id}"
          >
            Edit
          </button>

          <button
            class="delete-btn"
            data-id="${item.id}"
            data-image="${item.image_url || ""}"
          >
            Delete
          </button>

        </div>
      `;

      bakingGrid.appendChild(card);

    });


    document
      .querySelectorAll(".delete-btn")
      .forEach((button) => {

        button.addEventListener("click", async () => {

          const id = button.dataset.id;
          const imageUrl = button.dataset.image;

          const confirmed = confirm(
            "Delete this baking record?"
          );

          if (!confirmed) return;


          const {
            error: deleteError
          } = await supabase
            .from("baking")
            .delete()
            .eq("id", id);


          if (deleteError) {

            alert(
              "Failed to delete: " +
              deleteError.message
            );

            return;
          }


          // Try to remove Storage image
          if (imageUrl) {

            try {

              const fileName =
                imageUrl.split("/baking/")[1];

              if (fileName) {

                await supabase.storage
                  .from("baking")
                  .remove([fileName]);

              }

            } catch (storageError) {

              console.warn(
                "Storage image could not be removed:",
                storageError
              );

            }
          }


          await loadBaking();

        });

      });


    // Edit buttons

    document
      .querySelectorAll(".edit-btn")
      .forEach((button) => {

        button.addEventListener("click", () => {

          const item =
            data.find(
              record => record.id === Number(button.dataset.id)
            );

          if (item) {
            startEdit(item);
          }

        });

      });

  }


  // =========================
  // Edit helpers
  // =========================

  function startEdit(item) {

    editingId = item.id;
    editingImageUrl = item.image_url || "";

    titleInput.value = item.title || "";
    dateInput.value = item.date || "";
    descriptionInput.value = item.description || "";
    imageInput.value = "";

    // 编辑时图片可不换

    imageInput.required = false;
    imageHint.textContent =
      "Leave empty to keep the current image.";

    formTitle.textContent = "Edit Baking";
    saveBtn.textContent = "Update Baking";
    cancelEditBtn.style.display = "inline-flex";

    form.scrollIntoView({
      behavior: "smooth"
    });

  }


  function exitEdit() {

    editingId = null;
    editingImageUrl = "";

    form.reset();

    imageInput.required = true;
    imageHint.textContent = "";

    formTitle.textContent = "+ Add Baking";
    saveBtn.textContent = "Save Baking";
    cancelEditBtn.style.display = "none";

  }


  cancelEditBtn.addEventListener("click", () => {

    exitEdit();

  });


  // =========================
  // Add / Update Baking
  // =========================

  form.addEventListener("submit", async (event) => {

    event.preventDefault();

    saveBtn.disabled = true;
    saveBtn.textContent = "Saving...";


    try {

      const title =
        titleInput.value.trim();

      const date =
        dateInput.value;

      const description =
        descriptionInput.value.trim();

      const imageFile =
        imageInput.files[0];


      // 新增时图片必填，编辑时留空表示不换图

      if (!title || !date || (!editingId && !imageFile)) {

        alert(
          editingId
            ? "Please fill in the title and date."
            : "Please fill in the title, date and image."
        );

        return;
      }


      let imageUrl = "";


      // =========================
      // Upload image (only when a
      // new file was selected)
      // =========================

      if (imageFile) {

        const fileExt =
          imageFile.name
            .split(".")
            .pop();

        const fileName =
          `${Date.now()}-${crypto.randomUUID()}.${fileExt}`;


        const {
          error: uploadError
        } = await supabase.storage
          .from("baking")
          .upload(
            fileName,
            imageFile,
            {
              cacheControl: "3600",
              upsert: false
            }
          );


        if (uploadError) {

          throw uploadError;
        }


        // =========================
        // Get public URL
        // =========================

        const {
          data: publicUrlData
        } = supabase.storage
          .from("baking")
          .getPublicUrl(fileName);


        imageUrl =
          publicUrlData.publicUrl;

      }


      // =========================
      // Insert or update record
      // =========================

      if (editingId) {

        const recordData = {
          title,
          date,
          description
        };

        // 选了新图片才更换

        if (imageUrl) {
          recordData.image_url = imageUrl;
        }

        const {
          error: updateError
        } = await supabase
          .from("baking")
          .update(recordData)
          .eq("id", editingId);


        if (updateError) {

          throw updateError;
        }


        // 更换了新图片时，删除旧图片

        if (imageUrl && editingImageUrl) {

          try {

            const oldFileName =
              editingImageUrl.split("/baking/")[1];

            if (oldFileName) {

              await supabase.storage
                .from("baking")
                .remove([oldFileName]);

            }

          } catch (storageError) {

            console.warn(
              "Old image could not be removed:",
              storageError
            );

          }

        }


        alert("Baking updated successfully ♡");

      } else {

        const {
          error: insertError
        } = await supabase
          .from("baking")
          .insert({

            title,
            date,
            description,
            image_url: imageUrl

          });


        if (insertError) {

          throw insertError;
        }

        alert("Baking added successfully ♡");

      }


      exitEdit();

      await loadBaking();


    } catch (error) {

      console.error(error);

      alert(
        "Failed to save baking: " +
        error.message
      );

    } finally {

      saveBtn.disabled = false;
      saveBtn.textContent = editingId
        ? "Update Baking"
        : "Save Baking";

    }

  });


  // =========================
  // Logout
  // =========================

  logoutBtn.addEventListener("click", async () => {

    await supabase.auth.signOut();

    window.location.href = "/admin";

  });


  // =========================
  // Escape HTML
  // =========================

  function escapeHtml(value) {

    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

  }


  // =========================
  // Start
  // =========================

  const isAdmin = await checkAdmin();

  if (isAdmin) {
    await loadBaking();
  }
</script>

</body>
</html>