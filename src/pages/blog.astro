---
// src/pages/blog.astro
// 博客列表：改为浏览器端实时从 Supabase 读取，
// 后台新增/更新文章后无需重新部署即可在列表看到。
import "../styles/blog-records.css";
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <link rel="icon" type="image/png" href="/images/cursor3.png" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Blog</title>
</head>

<body>

  <main class="blog-records">

    <!-- 返回首页 -->
    <a href={`${import.meta.env.BASE_URL}`} class="back-link">
      ← back
    </a>


    <!-- 顶部标题 -->
    <header class="records-header">

      <p class="small-title">MY BLOG DIARY</p>

      <h1>
        My Blog<br />
        <span>Posts</span>
      </h1>

      <p class="intro">
        <span class="intro-cn">记录一些日常、想法和碎碎念……</span><br />
        words I wrote, remembered, and quietly kept in my diary.
      </p>

    </header>


    <!-- 博客列表（浏览器端填充） -->
    <section class="blog-list" id="blog-list">
      <div class="empty-blogs">Loading posts...♡</div>
    </section>


    <!-- 底部 -->
    <footer class="records-footer">
      <span>Uko's Diary</span>
      <span>♡</span>
      <span>My little blog</span>
    </footer>

  </main>

  <script>
    import { supabase } from "../lib/supabase.js";

    const base = import.meta.env.BASE_URL;

    // created_at 按北京时间格式化为 YYYY.MM.DD
    function formatDate(value) {
      if (!value) return "";
      const parts = new Intl.DateTimeFormat("en-CA", {
        timeZone: "Asia/Shanghai",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }).formatToParts(new Date(value));
      const get = (t) => parts.find((p) => p.type === t)?.value ?? "";
      return `${get("year")}.${get("month")}.${get("day")}`;
    }

    async function loadPosts() {
      const list = document.getElementById("blog-list");

      const { data, error } = await supabase
        .from("blogs")
        .select("id, title, created_at")
        .eq("is_visible", true)
        .order("created_at", { ascending: false });

      if (error) {
        console.error("读取博客失败：", error);
        list.innerHTML = '<div class="empty-blogs">Failed to load posts.</div>';
        return;
      }

      if (!data || data.length === 0) {
        list.innerHTML = '<div class="empty-blogs">No posts yet ♡</div>';
        return;
      }

      list.innerHTML = data.map((post, index) => `
        <a href="${base}blog/${post.id}/" class="blog-record">
          <div class="blog-number">${String(index + 1).padStart(2, "0")}</div>
          <div class="blog-info">
            <h2>${post.title ?? ""}</h2>
            <div class="blog-meta">
              <span>${formatDate(post.created_at)}</span>
            </div>
          </div>
          <div class="blog-arrow">↗</div>
        </a>
      `).join("");
    }

    loadPosts();
  </script>

</body>
</html>
